// client/client.rc - icons and manifest are embedded into the executable so
// client.exe also works without the resources/ folder and asks for
// elevation (UAC) on start.
#include <windows.h>

// RT_MANIFEST (24), id 1: Windows reads this as the requested execution level.
1 24 "client.manifest"

// File system icon of the executable.
101 ICON "resources/icons/exe_client.ico"

// Tray icons (PNG, RCDATA): loaded from the image resources.
201 RCDATA "resources/icons/tray_online_tarla_ag.png"
202 RCDATA "resources/icons/tray_offline_tarla_ag.png"

// Version block shown by Explorer (Properties -> Details) and by task tools.
// Project: RootLayer - FileDescription/ProductName "Root Layer",
// Author: levent INAN.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Author", "levent INAN"
            VALUE "CompanyName", "levent INAN"
            VALUE "FileDescription", "Root Layer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "client"
            VALUE "LegalCopyright", "levent INAN"
            VALUE "OriginalFilename", "client.exe"
            VALUE "ProductName", "Root Layer"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
