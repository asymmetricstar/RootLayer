// server/server.rc - the server icon is embedded so server.exe gets its own
// identity in Explorer and the task bar.
#include <windows.h>

// RT_MANIFEST (24), id 1: the gateway address, MTU, firewall rule and NAT are
// configured with netsh/PowerShell and require elevation.
1 24 "server.manifest"

101 ICON "resources/icons/exe_server.ico"

// Version block shown by Explorer (Properties -> Details) and by task tools.
// Project: RootLayer - FileDescription/ProductName "Root Layer",
// Author: levent INAN.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Author", "levent INAN"
            VALUE "CompanyName", "levent INAN"
            VALUE "FileDescription", "Root Layer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "server"
            VALUE "LegalCopyright", "levent INAN"
            VALUE "OriginalFilename", "server.exe"
            VALUE "ProductName", "Root Layer"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
